# ============================================================
# INUNDE OPS — Environment Variables
# ============================================================
# Copia este ficheiro para .env.local e preenche com os teus valores reais.
# NUNCA commites .env.local para o repositório.
#
# Como obter os valores:
#   1. Acede a https://supabase.com/dashboard
#   2. Seleciona o teu projecto
#   3. Vai a Settings → API
#   4. Copia "Project URL" e "anon public" key
# ============================================================

# ── Supabase (obrigatório) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — APENAS no servidor, NUNCA expor ao cliente
# Encontras em Settings → API → "service_role" key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App (opcional) ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
